# =============================================================================
# Founder Arena — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
#
# For Vercel deployment, add these in:
#   Settings → Environment Variables
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local: postgresql://user:password@localhost:5432/founder_arena?schema=public
# Vercel Postgres: postgresql://user:password@host.vercel-postgres.com:5432/db?sslmode=require
# Neon: postgresql://user:password@host.neon.tech/db?sslmode=require
# Supabase: postgresql://user:password@host.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/founder_arena?schema=public"

# ---------------------------------------------------------------------------
# Auth.js v5 (required for production)
# ---------------------------------------------------------------------------
# Generate a secure secret:
#   openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-chars-long-generate-me"

# Must match your deployed domain exactly:
#   Local dev:     http://localhost:3000
#   Vercel preview: https://your-project-git-branch.vercel.app
#   Vercel prod:    https://your-project.vercel.app
#   Custom domain:  https://your-domain.com
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth Providers (at least one required for closed beta)
# ---------------------------------------------------------------------------
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — create at https://github.com/settings/developers
# Callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# AI Provider (optional — falls back to deterministic mock mode)
# ---------------------------------------------------------------------------
# Option 1: OpenAI (default)
OPENAI_API_KEY=""

# Option 2: OpenRouter (free models available)
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODEL="deepseek/deepseek-chat:free"
# Or try: "meta-llama/llama-3.1-8b-instruct:free", "google/gemma-2-9b-it:free"

ANTHROPIC_API_KEY=""
KIMI_API_KEY=""
AI_PROVIDER="openai"

# ---------------------------------------------------------------------------
# Market Data Adapter (optional — static mode works without API keys)
# ---------------------------------------------------------------------------
# Provider mode: static | external | hybrid | seeded
MARKET_DATA_PROVIDER_MODE="static"
# Fallback when external providers fail: static | seeded | none
MARKET_DATA_EXTERNAL_FALLBACK="static"
NEWS_API_KEY=""
FRED_API_KEY=""

# ---------------------------------------------------------------------------
# Admin & Access Control
# ---------------------------------------------------------------------------
# Comma-separated list of admin emails for market snapshot generation.
# In development, any authenticated user can generate.
# In production, only these emails can generate snapshots.
ADMIN_EMAILS=""

# Cron secret for automated market snapshot generation.
# Generate with: openssl rand -base64 32
# Required for POST /api/cron/market-snapshot and GET /api/cron/generate-market-snapshot
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Rate Limiting (optional — recommended for production)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Stripe Billing (optional — required for subscriptions)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_MAX_MONTHLY=""
STRIPE_PRICE_MAX_YEARLY=""

# ---------------------------------------------------------------------------
# Rewarded Ads (optional — enable speed token ads)
# ---------------------------------------------------------------------------
# Set to "true" to show rewarded ad placements.
REWARDED_ADS_ENABLED="false"
# Set to "true" to simulate ad completion (grants tokens immediately).
REWARDED_ADS_SIMULATED="false"

# ---------------------------------------------------------------------------
# App Environment (optional)
# ---------------------------------------------------------------------------
# Set to "beta" to show a "Closed Beta" badge in the header.
# Leave empty or set to "production" for normal behavior.
APP_ENV=""

# ---------------------------------------------------------------------------
# Demo Mode (DEVELOPMENT ONLY — NEVER ENABLE IN PRODUCTION)
# ---------------------------------------------------------------------------
# Set to "true" to allow anonymous demo user fallback in local development.
# This bypasses OAuth and creates a shared demo user.
# DEMO_MODE_ENABLED="true"
DEMO_MODE_ENABLED="false"
