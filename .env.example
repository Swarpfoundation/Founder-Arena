# =============================================================================
# Founder Arena — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
#
# For Vercel deployment, add these in:
#   Settings → Environment Variables
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local: postgresql://user:password@localhost:5432/founder_arena?schema=public
# Vercel Postgres: postgresql://user:password@host.vercel-postgres.com:5432/db?sslmode=require
# Neon: postgresql://user:password@host.neon.tech/db?sslmode=require
# Supabase: postgresql://user:password@host.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/founder_arena?schema=public"

# ---------------------------------------------------------------------------
# Auth.js v5 (required for production)
# ---------------------------------------------------------------------------
# Generate a secure secret:
#   openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-chars-long-generate-me"

# Must match your deployed domain exactly:
#   Local dev:     http://localhost:3000
#   Vercel preview: https://your-project-git-branch.vercel.app
#   Vercel prod:    https://your-project.vercel.app
#   Custom domain:  https://your-domain.com
AUTH_URL="http://localhost:3000"

# Public base URL for share links and client-safe canonical URLs.
# Must not contain secrets.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth Providers (at least one required for closed beta)
# ---------------------------------------------------------------------------
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — create at https://github.com/settings/developers
# Callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Mobile Auth Token Exchange (native iOS)
# ---------------------------------------------------------------------------
# iOS opens /api/mobile-auth/start through ASWebAuthenticationSession.
# OAuth secrets stay server-side; iOS receives a backend-issued bearer token.
MOBILE_AUTH_ENABLED="true"
MOBILE_AUTH_ALLOWED_REDIRECT_URIS="founderarena://auth-callback"
MOBILE_AUTH_CODE_TTL_SECONDS="300"
MOBILE_AUTH_TOKEN_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# AI Provider (optional — falls back to deterministic mock mode)
# Priority: DeepSeek → Qwen → OpenAI/OpenRouter → Mock
# ---------------------------------------------------------------------------

# Option 1: DeepSeek (recommended — fast, affordable, OpenAI-compatible)
# Get your key at: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"   # default, no need to set
# DEEPSEEK_MODEL="deepseek-chat"                  # or "deepseek-reasoner" for R1

# Option 2: Qwen (Alibaba DashScope — OpenAI-compatible mode)
# Get your key at: https://dashscope.aliyuncs.com
# QWEN_API_KEY=""
# QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"  # default
# QWEN_MODEL="qwen-max"   # or "qwen-plus", "qwen-turbo", "qwen2.5-72b-instruct"

# Option 3: OpenAI (legacy)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL=""   # leave blank for https://api.openai.com/v1
# OPENAI_MODEL=""      # leave blank for gpt-4o

# Option 4: OpenRouter (access DeepSeek/Qwen via proxy — free tier available)
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODEL="deepseek/deepseek-chat"
# Or try: "qwen/qwen-2.5-72b-instruct", "deepseek/deepseek-r1:free"

# ---------------------------------------------------------------------------
# Private Beta AI Review Queue (optional)
# ---------------------------------------------------------------------------
# Main kill switch. Leave false to use the legacy/mock review path.
AI_REVIEW_ENABLED="false"
# mock | deepseek
AI_REVIEW_PROVIDER="mock"
# direct | queued_worker | mock
AI_REVIEW_MODE="direct"
# Set false if provider failures should fail honestly instead of using mock fallback.
AI_REVIEW_FALLBACK_TO_MOCK="true"
AI_REVIEW_MAX_DAILY_PER_USER="20"
AI_REVIEW_MAX_ATTEMPTS="3"
AI_REVIEW_TIMEOUT_MS="25000"
# Low temperature keeps VC review rubric judgments consistent during private beta.
AI_REVIEW_TEMPERATURE="0.2"
# Optional private beta ad hide switch. Keeps mock ad code intact but hides offers.
ADS_DISABLED="false"

# ---------------------------------------------------------------------------
# Market Data Adapter (optional — static mode works without API keys)
# ---------------------------------------------------------------------------
# Provider mode: static | external | hybrid | seeded
MARKET_DATA_PROVIDER_MODE="static"
# Fallback when external providers fail: static | seeded | none
MARKET_DATA_EXTERNAL_FALLBACK="static"
NEWS_API_KEY=""
FRED_API_KEY=""

# ---------------------------------------------------------------------------
# Admin & Access Control
# ---------------------------------------------------------------------------
# Comma-separated list of admin emails for market snapshot generation.
# In development, any authenticated user can generate.
# In production, only these emails can generate snapshots.
ADMIN_EMAILS=""

# Cron secret for automated market snapshot generation.
# Generate with: openssl rand -base64 32
# Required for POST /api/cron/market-snapshot and GET /api/cron/generate-market-snapshot
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Rate Limiting (optional — recommended for production)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Stripe Billing (optional — required for subscriptions)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_MAX_MONTHLY=""
STRIPE_PRICE_MAX_YEARLY=""

# ---------------------------------------------------------------------------
# Rewarded Ads (optional — enable speed token ads)
# ---------------------------------------------------------------------------
# Set to "true" to show rewarded ad placements.
REWARDED_ADS_ENABLED="false"
# Set to "true" to simulate ad completion (grants tokens immediately).
REWARDED_ADS_SIMULATED="false"

# ---------------------------------------------------------------------------
# App Environment (optional)
# ---------------------------------------------------------------------------
# Set to "beta" to show a "Closed Beta" badge in the header.
# Leave empty or set to "production" for normal behavior.
APP_ENV=""

# ---------------------------------------------------------------------------
# Demo Mode (DEVELOPMENT ONLY — NEVER ENABLE IN PRODUCTION)
# ---------------------------------------------------------------------------
# Set to "true" to allow anonymous demo user fallback in local development.
# This bypasses OAuth and creates a shared demo user.
# DEMO_MODE_ENABLED="true"
DEMO_MODE_ENABLED="false"

# ----- AI Investment Firm Deck Review (Phase 25A) -----
# Deck review reuses DEEPSEEK_API_KEY / DEEPSEEK_MODEL / AI_REVIEW_* above.
# DECK_REVIEW_ENABLED="true"            # or inherit AI_REVIEW_ENABLED
# DECK_REVIEW_PROVIDER="deepseek"       # alias: VC_REVIEW_PROVIDER; "mock" for offline local dev
# DECK_REVIEW_MODEL="deepseek-reasoner" # alias: VC_REVIEW_MODEL; defaults to DEEPSEEK_MODEL
# DECK_REVIEW_TIMEOUT_MS="45000"
# DECK_REVIEW_MAX_ATTEMPTS_PER_FIRM="2"
# DECK_REVIEW_MAX_FIRMS_PER_JOB="5"
# DECK_REVIEW_MAX_JOBS_PER_USER_PER_DAY="10"
# DECK_UPLOAD_DIR=""                    # private PDF dir; defaults to ./private-uploads/decks
# LOGO_UPLOAD_DIR=""                    # private logo dir; defaults to ./private-uploads/logos
# DECK_AI_ACCESS_DEV_BYPASS="false"     # development-only bypass for generation/review gating
